python3 - "$DATA/smi.json" << 'PYEOF'
import json, sys
d = json.load(open(sys.argv[1]))

print("+" + "-" * 77 + "+")
print(f"| NEXUS-SMI {d.get('host', '?')[:50]:<50} |")
print("+" + "-" * 77 + "+")

cpu = d.get("cpu", {})
info = cpu.get("info", {})
print(f"| CPU: {info.get('model', 'N/A')[:40]:<40} | Cores: {info.get('cores', '?'):<4} |")
print(f"| Usage: {cpu.get('usage_percent', 0):<6}% | Load: {cpu.get('loadavg', 'N/A')[:30]:<30} |")

mem = d.get("memory", {})
print(f"| RAM: {mem.get('total_gb', '?'):<6} GB | Free: {mem.get('available_gb', '?'):<6} GB | Usage: {mem.get('usage_percent', 0):<5}% |")

gpus = d.get("gpu", [])
print(f"| GPUs: {len(gpus)}")
for i, g in enumerate(gpus[:4]):
vendor = g.get("vendor", "?")
name = g.get("name", "?")
vram = g.get("vram_total_gb", "?")
print(f"| [{i}] {vendor} {name} — VRAM: {vram} GB")

disks = d.get("disks", [])
print(f"| Disks: {len(disks)}")
for disk in disks[:4]:
print(f"| {disk.get('name', '?'):<15} {disk.get('size_gb', '?'):<10} GB ({disk.get('model', '?')[:30]})")

zones = d.get("thermal", {}).get("zones", [])
if zones:
print(f"| Temps: ", end="")
for z in zones[:5]:
print(f"{z.get('name', '?')}={z.get('temp_c', '?')}°C ", end="")
print()

print("+" + "-" * 77 + "+")
PYEOF
}

