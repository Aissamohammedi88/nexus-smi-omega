write_jax_analyzer() {
local file="$SRC/jax_analyzer.py"
cat > "$file" << 'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Nexus SMI — JAX Analyzer (CORRIGÉ)
Analyse matricielle rapide des métriques système.
Fallback numpy si JAX absent.
"""
import json
import sys
import math
from pathlib import Path

JAX_AVAILABLE = False
NUMPY_AVAILABLE = False
jnp = None

# Try JAX first
try:
import jax
import jax.numpy as jnp
JAX_AVAILABLE = True
except ImportError:
pass

# Fallback numpy
if not JAX_AVAILABLE:
try:
import numpy
jnp = numpy
NUMPY_AVAILABLE = True
except ImportError:
pass


class JAXSystemAnalyzer:
"""Analyse les métriques système avec JAX ou numpy."""

def __init__(self):
self.available = JAX_AVAILABLE or NUMPY_AVAILABLE

def analyze(self, metrics):
if not self.available:
return {
"error": "JAX et numpy absents",
"recommendation": "pip install jax jaxlib OU pip install numpy",
"cpu_load": metrics.get("cpu_usage_percent", 0),
"mem_usage": metrics.get("mem_usage_percent", 0),
"gpu_count": metrics.get("gpu_count", 0),
}

results = {}

cpu_load = float(metrics.get("cpu_usage_percent", 0))
mem_usage = float(metrics.get("mem_usage_percent", 0))
gpu_count = float(metrics.get("gpu_count", 0))

state = jnp.array([cpu_load, mem_usage, gpu_count])

# Norme L2
norm = float(jnp.linalg.norm(state))
results["state_norm"] = round(norm, 4)

# Entropie normalisée
total = float(jnp.sum(state))
if total > 0:
probs = state / total
entropy = -float(jnp.sum(probs * jnp.log(probs + 1e-10)))
results["entropy"] = round(entropy, 4)
else:
results["entropy"] = 0.0

# Balanced ?
results["balanced"] = cpu_load < 70 and mem_usage < 80

# Health score (0-100)
score = 100 - (cpu_load * 0.4 + mem_usage * 0.4 + min(100, gpu_count * 10) * 0.2)
results["health_score"] = round(max(0, score), 2)

# Version info
if JAX_AVAILABLE:
results["backend"] = f"JAX {jax.__version__}"
elif NUMPY_AVAILABLE:
results["backend"] = f"numpy {numpy.__version__}"
else:
results["backend"] = "unavailable"

return results


def main():
smi_file = Path(__file__).parent.parent / "data" / "smi.json"
if not smi_file.exists():
print(json.dumps({"error": "smi.json absent. Lance collecte d'abord."}, indent=2))
return

try:
data = json.loads(smi_file.read_text())
except Exception as e:
print(json.dumps({"error": f"Lecture: {e}"}, indent=2))
return

metrics = {
"cpu_usage_percent": data.get("cpu", {}).get("usage_percent", 0),
"mem_usage_percent": data.get("memory", {}).get("usage_percent", 0),
"gpu_count": len(data.get("gpu", [])),
}

analyzer = JAXSystemAnalyzer()
results = analyzer.analyze(metrics)
print(json.dumps(results, indent=2))


if __name__ == "__main__":
main()
PYEOF
log OK " → jax_analyzer.py (CORRIGÉ)"
}

