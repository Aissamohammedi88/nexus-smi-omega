local file="$SRC/smi_core.py"
cat > "$file" << 'PYEOF'
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Nexus SMI — Core Python."""
import os, sys, json, re, subprocess, platform, time
from pathlib import Path
from datetime import datetime

class SMI:
def __init__(self):
self.data = {
"timestamp": datetime.utcnow().isoformat() + "Z",
"host": platform.node(),
"system": {},
"cpu": {},
"gpu": [],
"memory": {},
"disks": [],
"disk_usage": [],
"network": [],
"thermal": {"zones": [], "hwmon": []},
"power": {},
"pci": [],
"usb": [],
}

def _read(self, path):
try:
return Path(path).read_text().strip()
except Exception:
return None

def _run(self, cmd):
try:
r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
return r.stdout.strip()
except Exception:
return ""

def collect_system(self):
self.data["system"] = {
"os": platform.system(),
"release": platform.release(),
"machine": platform.machine(),
"uptime": self._read("/proc/uptime"),
}

def collect_cpu(self):
cpu = {"info": {}}
cpuinfo = self._read("/proc/cpuinfo")
if cpuinfo:
for line in cpuinfo.split("\n"):
if "model name" in line:
cpu["info"]["model"] = line.split(":")[1].strip()
break
cpu["info"]["cores"] = cpuinfo.count("processor\t:")
freq_dir = Path("/sys/devices/system/cpu/cpu0/cpufreq")
if freq_dir.exists():
cpu["freq"] = {
"current": self._read(str(freq_dir / "scaling_cur_freq")),
"min": self._read(str(freq_dir / "scaling_min_freq")),
"max": self._read(str(freq_dir / "scaling_max_freq")),
"governor": self._read(str(freq_dir / "scaling_governor")),
}
cpu["loadavg"] = self._read("/proc/loadavg")
stat = self._read("/proc/stat")
if stat:
for line in stat.split("\n"):
if line.startswith("cpu "):
parts = line.split()
total = sum(int(x) for x in parts[1:])
idle = int(parts[4])
cpu["usage_percent"] = round((1 - idle / total) * 100, 2) if total else 0
break
self.data["cpu"] = cpu

def collect_gpu(self):
gpus = []
for dri in Path("/sys/class/drm").glob("card*"):
if "-" in dri.name:
continue
gpu = {"name": dri.name}
device_path = dri / "device"
if device_path.exists():
vendor_id = self._read(str(device_path / "vendor"))
vendors = {
"0x10de": "NVIDIA", "0x1002": "AMD/ATI",
"0x8086": "Intel", "0x1af4": "Virtio",
}
gpu["vendor_id"] = vendor_id
gpu["vendor"] = vendors.get(vendor_id, "Unknown")
mem_total = self._read(str(device_path / "mem_info_vram_total"))
if mem_total:
try:
gpu["vram_total_gb"] = round(int(mem_total) / (1024**3), 2)
except Exception:
pass
for hwmon in device_path.glob("hwmon/hwmon*"):
temp = self._read(str(hwmon / "temp1_input"))
if temp:
try:
gpu["temperature_c"] = round(int(temp) / 1000, 1)
except Exception:
pass
gpus.append(gpu)

lspci = self._run("lspci 2>/dev/null | grep -iE 'vga|3d|display'")
if lspci and not gpus:
for line in lspci.split("\n"):
if line.strip():
gpus.append({"lspci": line.strip()})
self.data["gpu"] = gpus

def collect_memory(self):
mem = {}
meminfo = self._read("/proc/meminfo")
if meminfo:
for line in meminfo.split("\n"):
parts = line.split(":")
if len(parts) == 2:
key = parts[0].strip()
val = parts[1].strip().split()[0]
try:
mem[key] = int(val)
except ValueError:
pass
if "MemTotal" in mem:
mem["total_gb"] = round(mem["MemTotal"] / 1024 / 1024, 2)
if "MemAvailable" in mem:
mem["available_gb"] = round(mem["MemAvailable"] / 1024 / 1024, 2)
if mem.get("MemTotal"):
mem["usage_percent"] = round(
(1 - mem["MemAvailable"] / mem["MemTotal"]) * 100, 2
)
self.data["memory"] = mem

def collect_disks(self):
disks = []
for blk in Path("/sys/block").glob("*"):
name = blk.name
if name.startswith(("loop", "ram", "dm-")):
continue
disk = {"name": name}
size = self._read(str(blk / "size"))
if size:
try:
disk["size_gb"] = round(int(size) * 512 / (1024**3), 2)
except Exception:
pass
disk["model"] = self._read(str(blk / "device/model"))
disk["rotational"] = self._read(str(blk / "queue/rotational"))
disks.append(disk)
self.data["disks"] = disks

df = self._run("df -h 2>/dev/null | tail -n +2")
if df:
for line in df.split("\n"):
parts = line.split()
if len(parts) >= 6:
self.data["disk_usage"].append({
"filesystem": parts[0],
"size": parts[1],
"used": parts[2],
"avail": parts[3],
"use_pct": parts[4],
"mount": parts[5],
})

def collect_thermal(self):
for tz in Path("/sys/class/thermal").glob("thermal_zone*"):
z = {"name": tz.name}
z["type"] = self._read(str(tz / "type"))
temp = self._read(str(tz / "temp"))
if temp:
try:
z["temp_c"] = round(int(temp) / 1000, 1)
except Exception:
pass
self.data["thermal"]["zones"].append(z)
for hw in Path("/sys/class/hwmon").glob("hwmon*"):
h = {"name": self._read(str(hw / "name"))}
temps = []
for t in hw.glob("temp*_input"):
val = self._read(str(t))
if val:
try:
temps.append(round(int(val) / 1000, 1))
except Exception:
pass
h["temps"] = temps
self.data["thermal"]["hwmon"].append(h)

def collect_all(self):
self.collect_system()
self.collect_cpu()
self.collect_gpu()
self.collect_memory()
self.collect_disks()
self.collect_thermal()
return self.data

def save(self, path):
Path(path).write_text(json.dumps(self.data, indent=2, ensure_ascii=False))
return path


def main():
smi = SMI()
smi.collect_all()
if len(sys.argv) > 1 and sys.argv[1] == "--json":
print(json.dumps(smi.data, indent=2, ensure_ascii=False))
else:
print(f"Host: {smi.data['host']}")
print(f"CPU: {smi.data['cpu'].get('info', {}).get('model', 'N/A')}")
print(f"Cores: {smi.data['cpu'].get('info', {}).get('cores', 'N/A')}")
print(f"Usage: {smi.data['cpu'].get('usage_percent', 0)}%")
print(f"RAM: {smi.data['memory'].get('total_gb', 'N/A')} GB")
print(f"GPU: {len(smi.data['gpu'])}")
print(f"Disks: {len(smi.data['disks'])}")


if __name__ == "__main__":
main()
PYEOF
log OK " → smi_core.py"
}

write_cpp_engine() {
local file="$SRC/smi_engine.cpp"
cat > "$file" << 'CPPEOF'
// Nexus SMI — C++ Engine
#include <iostream>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>
#include <map>
#include <filesystem>
#include <mutex>
#include <iomanip>

namespace fs = std::filesystem;

class SMIEngine {
private:
std::map<std::string, std::string> data_;
std::mutex mutex_;

std::string read_file(const std::string& path) {
std::ifstream f(path);
if (!f.is_open()) return "";
std::stringstream ss;
ss << f.rdbuf();
std::string s = ss.str();
while (!s.empty() && (s.back() == '\n' || s.back() == ' ')) s.pop_back();
return s;
}

std::vector<std::string> read_lines(const std::string& path) {
std::vector<std::string> lines;
std::ifstream f(path);
std::string line;
while (std::getline(f, line)) {
if (!line.empty()) lines.push_back(line);
}
return lines;
}

public:
void collect_cpu() {
std::lock_guard<std::mutex> lock(mutex_);
auto lines = read_lines("/proc/cpuinfo");
for (const auto& line : lines) {
if (line.find("model name") != std::string::npos) {
auto pos = line.find(':');
if (pos != std::string::npos) {
data_["cpu_model"] = line.substr(pos + 2);
break;
}
}
}
int cores = 0;
for (const auto& line : lines) {
if (line.find("processor") != std::string::npos) cores++;
}
data_["cpu_cores"] = std::to_string(cores);

std::string load = read_file("/proc/loadavg");
if (!load.empty()) data_["cpu_loadavg"] = load;

auto stat_lines = read_lines("/proc/stat");
for (const auto& line : stat_lines) {
if (line.size() > 4 && line.substr(0, 4) == "cpu ") {
std::istringstream iss(line);
std::string label;
long user, nice, sys, idle, iowait, irq, softirq;
iss >> label >> user >> nice >> sys >> idle >> iowait >> irq >> softirq;
long total = user + nice + sys + idle + iowait + irq + softirq;
long used = total - idle;
double pct = total > 0 ? (100.0 * used / total) : 0.0;
std::stringstream ss;
ss << std::fixed << std::setprecision(2) << pct;
data_["cpu_usage_percent"] = ss.str();
break;
}
}
}

void collect_memory() {
std::lock_guard<std::mutex> lock(mutex_);
auto lines = read_lines("/proc/meminfo");
long total_kb = 0, avail_kb = 0;
for (const auto& line : lines) {
std::istringstream iss(line);
std::string key, unit;
long val;
iss >> key >> val >> unit;
if (key == "MemTotal:") total_kb = val;
if (key == "MemAvailable:") avail_kb = val;
}
if (total_kb > 0) {
std::stringstream ss;
ss << std::fixed << std::setprecision(2) << (total_kb / 1024.0 / 1024.0);
data_["mem_total_gb"] = ss.str();
ss.str("");
ss << std::fixed << std::setprecision(2) << (avail_kb / 1024.0 / 1024.0);
data_["mem_avail_gb"] = ss.str();
ss.str("");
ss << std::fixed << std::setprecision(2)
<< (100.0 * (1.0 - (double)avail_kb / total_kb));
data_["mem_usage_percent"] = ss.str();
}
}

void collect_gpus() {
std::lock_guard<std::mutex> lock(mutex_);
int count = 0;
std::string drm_path = "/sys/class/drm";
if (fs::exists(drm_path)) {
for (const auto& entry : fs::directory_iterator(drm_path)) {
std::string name = entry.path().filename().string();
if (name.substr(0, 4) == "card" && name.find("-") == std::string::npos) {
count++;
std::string vendor_file = entry.path().string() + "/device/vendor";
std::string vendor = read_file(vendor_file);
std::string vendor_name = "Unknown";
if (vendor == "0x10de") vendor_name = "NVIDIA";
else if (vendor == "0x1002") vendor_name = "AMD";
else if (vendor == "0x8086") vendor_name = "Intel";
data_["gpu_" + std::to_string(count) + "_vendor"] = vendor_name;
}
}
}
data_["gpu_count"] = std::to_string(count);
}

void collect_disks() {
std::lock_guard<std::mutex> lock(mutex_);
int count = 0;
std::string blk = "/sys/block";
if (fs::exists(blk)) {
for (const auto& entry : fs::directory_iterator(blk)) {
std::string name = entry.path().filename().string();
if (name.substr(0, 4) == "loop" || name.substr(0, 3) == "ram") continue;
count++;
std::string size = read_file(entry.path().string() + "/size");
if (!size.empty()) {
try {
long sectors = std::stol(size);
std::stringstream ss;
ss << std::fixed << std::setprecision(2)
<< (sectors * 512.0 / 1024 / 1024 / 1024);
data_["disk_" + std::to_string(count) + "_size_gb"] = ss.str();
} catch (...) {}
}
}
}
data_["disk_count"] = std::to_string(count);
}

void collect_thermal() {
std::lock_guard<std::mutex> lock(mutex_);
int count = 0;
std::string tp = "/sys/class/thermal";
if (fs::exists(tp)) {
for (const auto& entry : fs::directory_iterator(tp)) {
std::string name = entry.path().filename().string();
if (name.substr(0, 12) == "thermal_zone") {
count++;
std::string temp = read_file(entry.path().string() + "/temp");
if (!temp.empty()) {
try {
double t = std::stol(temp) / 1000.0;
std::stringstream ss;
ss << std::fixed << std::setprecision(1) << t;
data_["thermal_zone_" + std::to_string(count) + "_c"] = ss.str();
} catch (...) {}
}
}
}
}
data_["thermal_zone_count"] = std::to_string(count);
}

void print_summary() {
std::lock_guard<std::mutex> lock(mutex_);
std::cout << "=== NEXUS SMI (C++) ===" << std::endl;
std::cout << "CPU: " << data_["cpu_model"] << std::endl;
std::cout << "Cores: " << data_["cpu_cores"] << std::endl;
std::cout << "CPU usage: " << data_["cpu_usage_percent"] << "%" << std::endl;
std::cout << "RAM total: " << data_["mem_total_gb"] << " GB" << std::endl;
std::cout << "RAM usage: " << data_["mem_usage_percent"] << "%" << std::endl;
std::cout << "GPU count: " << data_["gpu_count"] << std::endl;
std::cout << "Disk count: " << data_["disk_count"] << std::endl;
}

void print_json() {
std::lock_guard<std::mutex> lock(mutex_);
std::cout << "{";
bool first = true;
for (const auto& kv : data_) {
if (!first) std::cout << ",";
std::cout << "\n \"" << kv.first << "\": \"" << kv.second << "\"";
first = false;
}
std::cout << "\n}" << std::endl;
}
};

int main(int argc, char** argv) {
SMIEngine smi;
smi.collect_cpu();
smi.collect_memory();
smi.collect_gpus();
smi.collect_disks();
smi.collect_thermal();

if (argc > 1 && std::string(argv[1]) == "--json") {
smi.print_json();
} else {
smi.print_summary();
}
return 0;
}
CPPEOF
log OK " → smi_engine.cpp"
}

write_rust_probe() {
local file="$SRC/smi_probe.rs"
cat > "$file" << 'RUSTEOF'
// Nexus SMI — Rust Probe
use std::fs;
use std::collections::HashMap;
use std::path::Path;

pub struct SMIProbe {
data: HashMap<String, String>,
}

impl SMIProbe {
pub fn new() -> Self {
Self { data: HashMap::new() }
}

fn read(&self, path: &str) -> Option<String> {
fs::read_to_string(path).ok().map(|s| s.trim().to_string())
}

pub fn collect_cpu(&mut self) {
if let Some(content) = self.read("/proc/cpuinfo") {
for line in content.lines() {
if line.starts_with("model name") {
if let Some(val) = line.split(':').nth(1) {
self.data.insert("cpu_model".into(), val.trim().into());
break;
}
}
}
let cores = content.matches("processor\t:").count();
self.data.insert("cpu_cores".into(), cores.to_string());
}
if let Some(load) = self.read("/proc/loadavg") {
self.data.insert("loadavg".into(), load);
}
}

pub fn collect_memory(&mut self) {
if let Some(content) = self.read("/proc/meminfo") {
let mut total = 0u64;
let mut avail = 0u64;
for line in content.lines() {
let parts: Vec<&str> = line.split_whitespace().collect();
if parts.len() >= 2 {
if parts[0] == "MemTotal:" {
total = parts[1].parse().unwrap_or(0);
} else if parts[0] == "MemAvailable:" {
avail = parts[1].parse().unwrap_or(0);
}
}
}
if total > 0 {
self.data.insert("mem_total_gb".into(),
format!("{:.2}", total as f64 / 1024.0 / 1024.0));
self.data.insert("mem_avail_gb".into(),
format!("{:.2}", avail as f64 / 1024.0 / 1024.0));
self.data.insert("mem_used_pct".into(),
format!("{:.2}", 100.0 * (1.0 - avail as f64 / total as f64)));
}
}
}

pub fn collect_gpus(&mut self) {
let drm = Path::new("/sys/class/drm");
let mut count = 0;
if drm.exists() {
if let Ok(entries) = fs::read_dir(drm) {
for entry in entries.flatten() {
let name = entry.file_name().to_string_lossy().to_string();
if name.starts_with("card") && !name.contains('-') {
count += 1;
let vendor_path = entry.path().join("device/vendor");
if let Ok(vendor) = fs::read_to_string(&vendor_path) {
let v = vendor.trim();
let vn = match v {
"0x10de" => "NVIDIA",
"0x1002" => "AMD",
"0x8086" => "Intel",
_ => "Unknown",
};
self.data.insert(format!("gpu_{}_vendor", count), vn.into());
}
}
}
}
}
self.data.insert("gpu_count".into(), count.to_string());
}

pub fn collect_disks(&mut self) {
let blk = Path::new("/sys/block");
let mut count = 0;
if blk.exists() {
if let Ok(entries) = fs::read_dir(blk) {
for entry in entries.flatten() {
let name = entry.file_name().to_string_lossy().to_string();
if name.starts_with("loop") || name.starts_with("ram") { continue; }
count += 1;
}
}
}
self.data.insert("disk_count".into(), count.to_string());
}

pub fn collect_thermal(&mut self) {
let tp = Path::new("/sys/class/thermal");
let mut count = 0;
if tp.exists() {
if let Ok(entries) = fs::read_dir(tp) {
for entry in entries.flatten() {
let name = entry.file_name().to_string_lossy().to_string();
if name.starts_with("thermal_zone") {
count += 1;
}
}
}
}
self.data.insert("thermal_zone_count".into(), count.to_string());
}

pub fn collect_all(&mut self) {
self.collect_cpu();
self.collect_memory();
self.collect_gpus();
self.collect_disks();
self.collect_thermal();
}

pub fn print_summary(&self) {
println!("=== NEXUS SMI (Rust) ===");
for k in &["cpu_model", "cpu_cores", "loadavg",
"mem_total_gb", "mem_used_pct",
"gpu_count", "disk_count", "thermal_zone_count"] {
if let Some(v) = self.data.get(*k) {
println!("{}: {}", k, v);
}
}
}

pub fn print_json(&self) {
print!("{{");
let mut first = true;
for (k, v) in &self.data {
if !first { print!(","); }
print!("\n \"{}\": \"{}\"", k, v);
first = false;
}
println!("\n}}");
}
}

fn main() {
let mut probe = SMIProbe::new();
probe.collect_all();
let args: Vec<String> = std::env::args().collect();
if args.len() > 1 && args[1] == "--json" {
probe.print_json();
} else {
probe.print_summary();
}
}
RUSTEOF
log OK " → smi_probe.rs"
}

