test_1_python_syntax() {
section "TEST 1 — SYNTAXE PYTHON"
local ok=0
for f in "$SRC/smi_core.py" "$SRC/jax_analyzer.py"; do
if python3 -m py_compile "$f" 2>"$LOGS/test_py_$(basename "$f").log"; then
log TEST "✅ $f : OK"
ok=$((ok+1))
else
log TEST "❌ $f : ERREUR"
cat "$LOGS/test_py_$(basename "$f").log"
fi
done
[ $ok -eq 2 ] && return 0 || return 1
}

test_2_collecte() {
section "TEST 2 — COLLECTE DONNÉES"
python3 "$SRC/smi_core.py" --json > "$TESTS/test_collect.json" 2>/dev/null
if [ -s "$TESTS/test_collect.json" ]; then
local size
size=$(wc -c < "$TESTS/test_collect.json")
log TEST "✅ Collecte OK : $size octets"
# Vérifier JSON valide
if python3 -c "import json; json.load(open('$TESTS/test_collect.json'))" 2>/dev/null; then
log TEST "✅ JSON valide"
return 0
else
log TEST "❌ JSON invalide"
return 1
fi
else
log TEST "❌ Collecte vide"
return 1
fi
}

test_3_cpp_rust() {
section "TEST 3 — BINAIRES C++/RUST"
local ok=0
[ -x "$BUILD/smi_cpp" ] && { log TEST "✅ smi_cpp existe"; ok=$((ok+1)); }
[ -x "$BUILD/smi_rust" ] && { log TEST "✅ smi_rust existe"; ok=$((ok+1)); }

if [ -x "$BUILD/smi_cpp" ]; then
"$BUILD/smi_cpp" --json > /dev/null 2>&1 && log TEST "✅ smi_cpp exécute" || log TEST "❌ smi_cpp échoue"
fi
if [ -x "$BUILD/smi_rust" ]; then
"$BUILD/smi_rust" --json > /dev/null 2>&1 && log TEST "✅ smi_rust exécute" || log TEST "❌ smi_rust échoue"
fi

[ $ok -ge 1 ] && return 0 || return 1
}

test_4_jax_analysis() {
section "TEST 4 — ANALYSE JAX"
local out
out=$(python3 "$SRC/jax_analyzer.py" 2>&1)
local exit_code=$?

if [ $exit_code -eq 0 ]; then
echo "$out" | head -20
log TEST "✅ JAX analyzer fonctionne"
return 0
else
log TEST "❌ JAX analyzer échoue"
echo "$out"
return 1
fi
}

